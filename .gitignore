__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

.env
*.log

data/user_settings/
data/logs/

# Scratch output from the documented walkthrough commands. The Big Data runners
# default here (bigdata/cli_common.py resolve_output_dir) and the README's IR
# examples are pointed here, so following the docs can never overwrite the
# committed evidence beside it (data/exports/bigdata/report*/, data/exports/*_sample.*).
data/exports/run/
data/exports/bigdata/run/
data/search_index/*.sqlite
data/live_ir/

# Full corpus artifacts are reproducible but too large for a normal GitHub repo.
data/processed_documents/sec_macro_company_ir_ppo_2010_2023_documents.jsonl
data/processed_documents/sec_dow30_ppo_2010_2023_1740_sections_documents.jsonl
data/processed_documents/sec_dow30_ppo_2010_2023_1800_with_dis_legacy_sections_documents.jsonl
data/raw_documents/sec_dow30_ppo_2010_2023_1740_sections.jsonl
data/raw_documents/sec_dow30_ppo_2010_2023_1800_with_dis_legacy_sections.jsonl
data/exports/**/retrieved_contexts.jsonl
data/exports/**/rl_panel_*.csv


# Big Data layer: dynamic streaming state and potentially huge postings dumps.
data/streaming_inbox/
data/exports/bigdata/streaming_state/
data/exports/bigdata/**/postings.jsonl

# Spark-built search-index artifacts: manifest only; the .sqlite itself is ~800MB.
data/exports/bigdata/search_index/*.sqlite

# Spark event logs (per-run; replayed by the History Server, regenerated locally).
# The three runs behind the heavy-load result in BIG_DATA_INFRASTRUCTURE.md section
# 11 are kept, so a reader can replay them instead of taking the timings on trust.
data/spark-events/*
!data/spark-events/app-20260907055921-0000
!data/spark-events/app-20260907060016-0001
!data/spark-events/app-20260907060137-0002

# Point-in-time macro corpus (ALFRED vintages): ~91MB. Reproduce with the full
# command in docs/MAIN_METHODOLOGY.md 2.1.1 -- the --output-raw/--output-processed
# overrides are required, since the builder's defaults are the estimate-regime
# corpus. The summary JSON next to them IS tracked.
data/raw_documents/official_macro_2010_2023_pit.jsonl
data/processed_documents/official_macro_2010_2023_pit_documents.jsonl

# PowerPoint lock files.
~$*.pptx
